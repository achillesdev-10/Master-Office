# ================================================================
#  Super Admin Dashboard — Variables d'environnement
#  Copier ce fichier :  cp .env.example .env
#  Puis renseigner chaque valeur.
#  ⚠️  .env est ignoré par git — ne jamais committer de secrets.
# ================================================================

# ----------------------------------------------------------------
# 1. Base de données (PostgreSQL : Neon / Supabase / Vercel Postgres)
# ----------------------------------------------------------------
# URL principale utilisée par Prisma au runtime (peut passer par un
# pooler PgBouncer pour les serverless functions Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/superadmin?sslmode=require"

# URL directe (sans pooler) utilisée pour les migrations Prisma.
# Optionnelle : décommenter si ton provider en fournit une.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/superadmin?sslmode=require"

# ----------------------------------------------------------------
# 2. Clerk (authentification)
# ----------------------------------------------------------------
# Clé publique exposée côté client (préfixe pk_test_ / pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Clé secrète côté serveur uniquement (préfixe sk_test_ / sk_live_)
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Secret de signature des webhooks Clerk (dashboard Clerk > Webhooks),
# utilisé pour /api/webhooks/clerk (svix)
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# Route de connexion → page src/app/(auth)/login (<SignIn />)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"

# ----------------------------------------------------------------
# 3. Upstash Redis (rate limiting, caching, queues légères)
# ----------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://xxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ----------------------------------------------------------------
# 4. Vercel Blob (stockage des fichiers : logos, avatars, exports)
# ----------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ----------------------------------------------------------------
# 5. Domaines / multi-tenant
# ----------------------------------------------------------------
# Domaine racine hébergeant le dashboard + les sous-domaines tenant
# ex. NEXT_PUBLIC_ROOT_DOMAIN="acme.com"  ->  {tenant}.acme.com
NEXT_PUBLIC_ROOT_DOMAIN="example.com"
# URL publique de l'application (SEO, liens absolus, webhooks entrants)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------
# 6. Emails transactionnels (Resend)
# ----------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Expéditeur vérifié dans Resend (format "Nom <email@domaine.tld>")
EMAIL_FROM="Super Admin <onboarding@resend.dev>"

# ----------------------------------------------------------------
# 7. Divers
# ----------------------------------------------------------------
# Mode d'exécution : development | production | test
NODE_ENV="development"

# ----------------------------------------------------------------

# ----------------------------------------------------------------
# 8. Secrets & domaines (modules 7 & 8)
# ----------------------------------------------------------------
# Cle de chiffrement des cles API paiement (AES-256-GCM).
# 32 octets en hexadecimal (64 caracteres) - generer avec :
#   node -e ""console.log(require('crypto').randomBytes(32).toString('hex'))""
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Cible CNAME attendue pour la verification DNS des domaines
VERCEL_CNAME_TARGET="cname.vercel-dns.com"
# Token API Vercel (regeneration des certificats SSL - module 8)
# VERCEL_API_TOKEN="vercel_XXXXXXXXXXXXXXXXXXXXXXXX"
